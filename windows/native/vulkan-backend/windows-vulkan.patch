 # Xbox D3D8 Compatibility Layer
-#   _WIN32 -> backed by Direct3D 11 (d3d8_*.c, d3d8_combiners.c, d3d8_vsh.c)
-#   POSIX  -> backed by OpenGL 3.3 core via SDL2 + libepoxy (d3d8_gl.c)
+# Backend selection is independent of the host OS. djultra64.
+# Preserve the historical defaults: D3D11 on Windows, Vulkan on POSIX.
+if(WIN32)
+    set(XBOXRECOMP_VULKAN_DEFAULT OFF)
+else()
+    set(XBOXRECOMP_VULKAN_DEFAULT ON)
+endif()
+option(XBOXRECOMP_VULKAN "Build the Vulkan Direct3D 8 device" ${XBOXRECOMP_VULKAN_DEFAULT})
 
-if(WIN32)
