--- a/src/apu/apu_mmio_hook.c
+++ b/src/apu/apu_mmio_hook.c
@@ -10,6 +10,7 @@
 #include <stdlib.h>
 #include <stdbool.h>
 #include <stdint.h>
+#include <string.h>
 
 /* Global APU state pointer -- referenced from main.c regardless of which
  * platform's MMIO hook is active, so define it before the #if guard. */
@@ -67,7 +68,10 @@
     int len = 1;
 
     if (mod == 3) return 1;
-    if ((rm & 7) == 4) len += 1; /* SIB */
+    if ((rm & 7) == 4) {
+        len += 1; /* SIB */
+        if (mod == 0 && (ip[1] & 7) == 5) len += 4; /* no-base SIB disp32 */
+    }
     if (mod == 0 && (rm & 7) == 5) len += 4; /* disp32 */
     else if (mod == 1) len += 1;
     else if (mod == 2) len += 4;
@@ -173,6 +177,38 @@
         uint64_t val = mcpx_apu_mmio_read(g_apu_state, mmio_offset, 2);
         *ctx_reg64(ctx, reg) = val & 0xFFFF;
         ctx->Rip += prefix_len + 2 + modrm_len;
+        g_apu_mmio_read_count++;
+        return true;
+    }
+
+    /* TEST r/m, immediate (F6/F7 /0): Clang may fold an APU poll into
+     * this read-only instruction. Preserve operand width and defined flags.
+     * Other group operations and register-only forms are not MMIO reads. */
+    if (opcode[0] == 0xF6 || opcode[0] == 0xF7) {
+        if (is_write || ((opcode[1] >> 3) & 7) != 0 || (opcode[1] >> 6) == 3)
+            return false;
+        if (opcode[0] == 0xF6) access_size = 1;
+        int modrm_len = decode_modrm_len(opcode + 1, rex_b);
+        const uint8_t *operand = opcode + 1 + modrm_len;
+        uint64_t immediate;
+        int immediate_size;
+        if (access_size == 1) { immediate = *operand; immediate_size = 1; }
+        else if (access_size == 2) {
+            uint16_t value; memcpy(&value, operand, sizeof value);
+            immediate = value; immediate_size = 2;
+        } else {
+            uint32_t value; memcpy(&value, operand, sizeof value);
+            immediate = (uint64_t)(int64_t)(int32_t)value; immediate_size = 4;
+        }
+        uint64_t result = mcpx_apu_mmio_read(g_apu_state, mmio_offset, access_size) & immediate;
+        if (access_size < 8) result &= (1ULL << (access_size * 8)) - 1;
+        unsigned parity = (unsigned)result & 0xFFu;
+        parity ^= parity >> 4; parity ^= parity >> 2; parity ^= parity >> 1;
+        ctx->EFlags &= ~0x8C5u; /* CF, PF, ZF, SF, OF; AF is undefined. */
+        if (!(parity & 1)) ctx->EFlags |= 0x4u;
+        if (!result) ctx->EFlags |= 0x40u;
+        if (result & (1ULL << (access_size * 8 - 1))) ctx->EFlags |= 0x80u;
+        ctx->Rip += prefix_len + 1 + modrm_len + immediate_size;
         g_apu_mmio_read_count++;
         return true;
     }
