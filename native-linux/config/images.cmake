# Shared explicit title image whitelist. Own work: djultra64.
file(READ "${CMAKE_CURRENT_LIST_DIR}/images.json" TOPSPIN_IMAGE_CATALOG)
string(JSON TOPSPIN_IMAGE_COUNT LENGTH "${TOPSPIN_IMAGE_CATALOG}")
math(EXPR TOPSPIN_IMAGE_LAST "${TOPSPIN_IMAGE_COUNT}-1")
set(TOPSPIN_IMAGE_NAMES)
foreach(TOPSPIN_IMAGE_INDEX RANGE 0 ${TOPSPIN_IMAGE_LAST})
    string(JSON TOPSPIN_IMAGE_KEY MEMBER "${TOPSPIN_IMAGE_CATALOG}" ${TOPSPIN_IMAGE_INDEX})
    if(NOT TOPSPIN_IMAGE_KEY MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid key in title image whitelist")
    endif()
    list(APPEND TOPSPIN_IMAGE_NAMES "${TOPSPIN_IMAGE_KEY}")
endforeach()
if(NOT TOPSPIN_IMAGE IN_LIST TOPSPIN_IMAGE_NAMES)
    message(FATAL_ERROR "Unknown Top Spin image: ${TOPSPIN_IMAGE}")
endif()
string(JSON XBE_NAME GET "${TOPSPIN_IMAGE_CATALOG}" "${TOPSPIN_IMAGE}")
if(NOT XBE_NAME MATCHES "^(default|TopSpin\\([A-Za-z]+\\))\\.xbe$")
    message(FATAL_ERROR "Invalid filename in title image whitelist")
endif()
